FROM python:3.12-slim

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libcurl4-openssl-dev \
    curl \
    libssl-dev \
    cmake \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# ===========================================================================
# CAPA 1: PyTorch + CUDA 12.8 (cu128)
# ===========================================================================
RUN uv pip install --system --no-cache \
    torch torchvision torchaudio \
    --extra-index-url https://download.pytorch.org/whl/cu128

# ===========================================================================
# CAPA 2: Unsloth desde GIT (Versión Blackwell/SOTA)
# Instalar directamente desde GitHub es la recomendación oficial para 
# evitar conflictos de NameError: PreTrainedConfig en Docker.
# ===========================================================================
RUN uv pip install --system --no-cache \
    "unsloth[colab-new] @ git+https://github.com/unslothai/unsloth.git" \
    "unsloth_zoo @ git+https://github.com/unslothai/unsloth-zoo.git"

# ===========================================================================
# CAPA 3: Satélites y dependencias de runtime (Unsloth ya instaló transformers/trl)
# Nos aseguramos de tener psutil y hf-transfer.
# ===========================================================================
RUN uv pip install --system --no-cache \
    "psutil" \
    "hf-transfer" \
    "bitsandbytes" \
    "accelerate" \
    "datasets"

# ===========================================================================
# CAPA 4: Dependencias del proyecto (Celery, FastAPI, MinIO, etc.)
# ===========================================================================
COPY pyproject.toml .
RUN uv pip install --system --no-cache .

COPY . .

CMD ["celery", "-A", "app.core.celery_app", "worker", "--loglevel=info", "--concurrency=1", "-P", "solo", "--max-tasks-per-child=1"]
